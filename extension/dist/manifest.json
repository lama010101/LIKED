{
  "manifest_version": 3,
  "name": "LIKED — Save to Library",
  "version": "0.1.0",
  "description": "Save any URL to your LIKED library with one click. Quick save by default, optional title, description, tags, and collection.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://liked.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to LIKED",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "externally_connectable": {
    "matches": ["https://liked.app/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*", "http://localhost:3001/*", "http://127.0.0.1:3001/*"]
  }
}
