# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
extension/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp/scratch scripts and audit outputs
temp_*.js
temp_*.sql
.tmp-*.js
.tmp-*.mjs
tsc-*.txt
audit_*.json
audit_*.txt
audit_query*.txt
build.log

# supabase temp
supabase/.temp/

.vercel

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# extension packages (built artifacts — run zip:extension / crx:extension to regenerate)
/public/liked-extension.zip
/public/liked-extension.crx

# local editor workspace
LIKED.code-workspace

# credential files (tokens, keys, keystores — local-only secrets)
.supabase_access_token
.*access_token*
*.key
*.p12
*.pfx
*.keystore
*.kdbx
id_rsa*
