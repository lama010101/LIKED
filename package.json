{
  "name": "liked",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:extension": "npm --prefix extension run build",
    "dev:extension": "npm --prefix extension run dev",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vercel": "BASE_URL=https://liked-zeta.vercel.app npx playwright test",
    "test:vercel:headed": "BASE_URL=https://liked-zeta.vercel.app npx playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "dotenv": "^16.4.5",
    "next": "^16.3.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
